{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "node scripts/ensure-dev-cert.mjs && vite",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:local:seeded": "node scripts/dev-local.mjs --seed-dev-profiles",
    "test:profile-photo-apis": "node scripts/smoke-real-profile-photo-upload.mjs",
    "smoke:profile-photo": "node scripts/smoke-real-profile-photo-upload.mjs",
    "security:check": "bash scripts/security-check.sh",
    "ship": "node scripts/ship.mjs",
    "check:copy": "node scripts/check-lowercase-cruush.mjs",
    "check:layout": "node scripts/check-layout-invariants.mjs",
    "docs:worktrees": "node scripts/update-worktrees-doc.mjs",
    "docs:env": "node scripts/update-env-matrix.mjs",
    "test": "vitest run",
    "test:release-coolify": "npm --prefix server run test:release-coolify",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "smoke": "pnpm test:smoke && pnpm --dir server test:smoke"
  },

# Frontend environment variables.
# VITE_* values are public in the browser. Do not put backend secrets here.
# Optional if the API is not served from the same origin or through the Vite proxy.
# VITE_API_BASE_URL=http://127.0.0.1:3001
# VITE_TURNSTILE_SITE_KEY=
# Legacy compatibility key; moderator routes are always mounted and protected by role checks.
# VITE_HUMAN_MODERATION_ENABLED=false
# Optional map overrides. Defaults use a custom dark vector style backed by OpenFreeMap
# tiles. Map labels use the app's loaded Cormorant Garamond CSS font through
# MapLibre local glyph rendering.
# VITE_MAP_STYLE_URL bypasses the in-app cruush vector style, including its label fonts.
# VITE_MAP_STYLE_URL=
# VITE_MAP_VECTOR_TILEJSON_URL=https://tiles.openfreemap.org/planet
# Optional self-hosted glyph PBF URL. Only set this if it contains Cormorant Garamond stacks.
# VITE_MAP_GLYPHS_URL=
# Optional raster tile fallback. Setting this also bypasses the in-app Cormorant vector style.
# VITE_MAP_TILE_URL=https://a.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; CARTO &copy; OpenStreetMap contributors

# Backend environment variables used by the self-hosted server.
# TWO_FACTOR_ENCRYPTION_KEY=
# TWO_FACTOR_ENCRYPTION_KEY_VERSION=v1
# APP_URL=https://localhost:5175
# MEDIA_STORAGE_DIR=media
# MEDIA_PUBLIC_BASE_URL=https://api-staging.cruush.app
# MEDIA_MODERATION_URL_SECRET=
# MEDIA_MODERATION_URL_TTL_SECONDS=120
# MEDIA_OBJECT_STORAGE_DRIVER=local
# MEDIA_S3_BUCKET=
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_REGION=auto
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MODERATION_PROVIDER=mock
# MODERATION_TIMEOUT_MS=5000
# STREAM_MODERATION_ENABLED=false
# Legacy compatibility key; moderator routes are always mounted and protected by role checks.
# HUMAN_MODERATION_ENABLED=false
# STREAM_IMAGE_BRIDGE_ENABLED=false
# PROFILE_PHOTO_STREAM_AUTOMOD_ENABLED=false
# PROFILE_PHOTO_REKOGNITION_ENABLED=false
# PROFILE_PHOTO_REKOGNITION_REGION=us-east-1
# PROFILE_PHOTO_REKOGNITION_HUMAN_CONFIDENCE=90
# PROFILE_PHOTO_REKOGNITION_ANIMAL_CONFIDENCE=80
# PROFILE_PHOTO_REKOGNITION_FACE_CONFIDENCE=90
# PROFILE_PHOTO_REKOGNITION_MINIMUM_AGE=18
# PROFILE_PHOTO_REKOGNITION_TIMEOUT_MS=5000
# ALPHA_PROFILE_PHOTO_UPLOADS_WITHOUT_PHOTODNA_ENABLED=false
# SEVERE_ACCESS_BANS_ENABLED=false
# SEVERE_ACCESS_BAN_HMAC_KEY=
# TRUST_PROXY_HOPS=0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# STREAM_API_KEY=
# STREAM_API_SECRET=
# STREAM_APP_ID=
# STREAM_MODERATION_CONFIG_KEY=
# MODERATION_MEDIA_BASE_URL=
# STREAM_PSEUDONYM_KEY=
# PHOTODNA_ENABLED=false
# PHOTODNA_API_URL=
# PHOTODNA_OPERATION_PATH=

PORT=3001
HOST=127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5433/cruush
CORS_ORIGIN=http://localhost:5173,https://localhost:5173,http://127.0.0.1:5173,https://127.0.0.1:5173
SESSION_SECRET=change-me
# Optional dedicated key for TOTP secret encryption. In production, set a
# strong independent value; when omitted, SESSION_SECRET is used.
TWO_FACTOR_ENCRYPTION_KEY=
TWO_FACTOR_ENCRYPTION_KEY_VERSION=v1
APP_URL=https://localhost:5173
APP_DEPLOYMENT_STAGE=development
# Public deployment metadata. Coolify can set this from SOURCE_COMMIT.
APP_BUILD_SHA=
MEDIA_STORAGE_DIR=media
MEDIA_PUBLIC_BASE_URL=http://localhost:3001
MEDIA_MODERATION_URL_SECRET=
MEDIA_MODERATION_URL_TTL_SECONDS=900
MEDIA_OBJECT_STORAGE_DRIVER=local
MEDIA_S3_BUCKET=
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=auto
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MODERATION_PROVIDER=mock
MODERATION_TIMEOUT_MS=5000
STREAM_MODERATION_ENABLED=false
STREAM_IMAGE_BRIDGE_ENABLED=false
PROFILE_PHOTO_STREAM_AUTOMOD_ENABLED=false
# Rekognition classifies photos on its own whenever the primary provider cannot:
# Stream erroring, Stream not configured, or the mock provider (filenames only).
# Leave this off and nothing is ever marked explicit, so DL Mode masks nothing.
# Needs AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY below, or an instance IAM role.
PROFILE_PHOTO_REKOGNITION_ENABLED=true
PROFILE_PHOTO_REKOGNITION_REGION=us-east-1
PROFILE_PHOTO_REKOGNITION_HUMAN_CONFIDENCE=90
PROFILE_PHOTO_REKOGNITION_ANIMAL_CONFIDENCE=80
PROFILE_PHOTO_REKOGNITION_FACE_CONFIDENCE=90
PROFILE_PHOTO_REKOGNITION_MINIMUM_AGE=18
PROFILE_PHOTO_REKOGNITION_TIMEOUT_MS=5000
SEVERE_ACCESS_BANS_ENABLED=false
SEVERE_ACCESS_BAN_HMAC_KEY=
# Set to the verified number of reverse-proxy hops before enabling IP bans.
TRUST_PROXY_HOPS=0
# Use an IAM role when available; otherwise supply a Rekognition-only AWS access key.
#
# PRODUCTION USES THE IAM USER NAMED `cruush-rekognition-staging` (account
# 741180448899). The name says staging; it is not. It is the live credential that
# screens every profile and message photo.
#
# Do not delete it during an AWS cleanup. Photo moderation fails closed, so if this
# credential stops working, photo uploads stop for everyone rather than degrading -
# users get "We could not check this photo for harmful content."
#
# Replacing it safely: create the new IAM user, put its key in Coolify on cruush-api,
# confirm uploads still work, and only then delete the old user. Never rename in
# place - anything referencing the old ARN keeps pointing at a name that no longer
# exists. `pnpm --dir server health:rekognition` verifies a key end to end.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
STREAM_API_KEY=
STREAM_API_SECRET=
STREAM_APP_ID=
STREAM_MODERATION_CONFIG_KEY=
MODERATION_MEDIA_BASE_URL=
STREAM_PSEUDONYM_KEY=
BANK_PROFILE_PHOTO_MANUAL_REVIEW_ENABLED=false
BANK_PROFILE_PHOTO_TESTER_USER_IDS=
PHOTODNA_ENABLED=false
PHOTODNA_API_URL=
PHOTODNA_OPERATION_PATH=
PHOTODNA_SUBSCRIPTION_KEY=
PHOTODNA_TIMEOUT_MS=5000
CSAM_REPORTING_ENABLED=false
CSAM_REPORTING_MODE=manual_packet
CSAM_REPORTING_TEST_MODE=false
TRUST_SAFETY_ALERT_EMAIL=
SUPPORT_INBOX_EMAIL=reports@cruush.app
INTERNAL_API_SECRET=
# Mirrors category=bug support requests into GitHub issues (npm run bugs:sync-issues).
# The token needs issues:write on GITHUB_BUG_TRIAGE_REPO and nothing else.
GITHUB_BUG_TRIAGE_ENABLED=false
GITHUB_BUG_TRIAGE_REPO=cruush-social/Cruushv2
GITHUB_BUG_TRIAGE_TOKEN=
GITHUB_BUG_TRIAGE_LABEL=bug-report
MAIL_FROM=cruush <hello@cruush.app>
RESEND_API_KEY=
RESEND_CRUUSH_APP_AUDIENCE_ID=
EMAIL_PREVIEW_ENABLED=false
BILLING_TEST_CHECKOUT_ENABLED=false
DEVELOPMENT_ADMIN_ENABLED=false
DEVELOPMENT_ADMIN_PASSWORD=
REVIEWER_TEST_ACCOUNTS_ENABLED=false
REVIEWER_TEST_ACCOUNT_PASSWORD=
BANK_REVIEWER_ACCOUNT_PASSWORD=
TURNSTILE_SECRET_KEY=
PROFILE_ENCRYPTION_KEY=
PROFILE_TOKEN_KEY=
PROFILE_TOKEN_KEY_VERSION=v1
RELATIONSHIP_ENCRYPTION_KEY=
RELATIONSHIP_INDEX_KEY=
RELATIONSHIP_ENCRYPTION_KEY_VERSION=v1
RELATIONSHIP_INDEX_KEY_VERSION=v1
CLUB_ENROLLMENT_ENCRYPTION_KEY=
CLUB_ENROLLMENT_INDEX_KEY=
CLUB_ENROLLMENT_ENCRYPTION_KEY_VERSION=v1
CLUB_ENROLLMENT_INDEX_KEY_VERSION=v1
MATCH_TOKEN_ENCRYPTION_KEY=
MATCH_TOKEN_SIGNING_KEY=
MATCH_TOKEN_KEY_VERSION=v1
MESSAGE_ENCRYPTION_KEY=
MESSAGE_ENCRYPTION_KEY_VERSION=v1
FEED_ENCRYPTION_KEY=
FEED_ENCRYPTION_KEY_VERSION=v1
MEDIA_ENCRYPTION_KEY=
MEDIA_ENCRYPTION_KEY_VERSION=v1
LOCATION_ENCRYPTION_KEY=
LOCATION_INDEX_KEY=
VISIBILITY_POLICY_ENCRYPTION_KEY=
GHOST_DERIVATION_KEY=
DISPLAY_TOKEN_ENCRYPTION_KEY=
LOCATION_ENCRYPTION_KEY_VERSION=v1
LOCATION_INDEX_KEY_VERSION=v1
VISIBILITY_POLICY_ENCRYPTION_KEY_VERSION=v1
GHOST_DERIVATION_KEY_VERSION=v1
DISPLAY_TOKEN_ENCRYPTION_KEY_VERSION=v1
# Optional previous encryption secrets. These are only needed for a separately
# authorized rotation. Do not rotate blind-index, token-hash, or signing keys
# through this fallback; they require their own migration strategy.
# PROFILE_ENCRYPTION_KEY_PREVIOUS=
# MESSAGE_ENCRYPTION_KEY_PREVIOUS=
# FEED_ENCRYPTION_KEY_PREVIOUS=
# MEDIA_ENCRYPTION_KEY_PREVIOUS=
# RELATIONSHIP_ENCRYPTION_KEY_PREVIOUS=
# CLUB_ENROLLMENT_ENCRYPTION_KEY_PREVIOUS=
# MATCH_TOKEN_ENCRYPTION_KEY_PREVIOUS=
# LOCATION_ENCRYPTION_KEY_PREVIOUS=
# VISIBILITY_POLICY_ENCRYPTION_KEY_PREVIOUS=
# GHOST_DERIVATION_KEY_PREVIOUS=
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:hello@cruush.app

# Direct USDC checkout stays off unless explicitly enabled. Configure only a
# watch-only receive-chain xpub exported at m/44'/60'/0'/0. Never put an xprv,
# seed phrase, or private key in any application environment.
CRYPTO_PROCESSOR_ENABLED=false
CRYPTO_PROCESSOR_BITCOIN_WALLET_XPUB=
# Bitcoin mainnet Esplora API base URL, shared with the automatic forwarding service.
CRYPTO_PROCESSOR_BITCOIN_ESPLORA_URL=
CRYPTO_PROCESSOR_WALLET_XPUB=
CRYPTO_PROCESSOR_CONFIRMATION_TARGET=1
# New orders allow 24 hours for on-chain arrival. Existing order deadlines stay fixed.
CRYPTO_PROCESSOR_INTENT_TTL_MINUTES=1440
# Read-only JSON-RPC endpoints for the settlement watcher. Empty means that
# chain is never watched. These may embed an API key, so treat them as secrets:
# server-only, never logged, never returned to a client.
#
# This costs nothing to run, by design and on purpose:
#   - No payment in progress means NO request at all, not even a head read. An
#     idle processor is free rather than polling forever.
#   - Abandoned checkouts stop being watched 7 days after they expire, so the
#     watch set cannot grow without bound and drag the cost up over time.
#   - The poll is 60 seconds, because the confirmation wait dominates anyway.
# Active polling makes at least three RPC calls per configured chain each
# minute, plus one block lookup per candidate height. Daily usage therefore
# scales with active chains and transfer volume; verify provider limits before
# enabling a rail.
#
# Endpoint: https://arb1.arbitrum.io/rpc. Arbitrum's own public endpoint, no
# account and no key. Dwellir's free plan was tried and refuses eth_getLogs with
# HTTP 403. That method is required for transfer discovery, so no request
# volume would have made it work. Verified 2026-09-01 decoding 456 of 456 real
# USDC transfers over a 200-block range. No availability guarantee; swapping to
# a paid provider is a one-line change here.
CRYPTO_PROCESSOR_ARBITRUM_RPC_URL=
CRYPTO_PROCESSOR_BASE_RPC_URL=
CRYPTO_PROCESSOR_ETHEREUM_RPC_URL=
# Base Sepolia is a test network. Its USDC and its gas are free from faucets, so
# it exists only to prove settlement end to end without spending money. Its
# tokens are worthless, so CRYPTO_PROCESSOR_TESTNET_ENABLED must never be true
# in production: the server refuses to boot if it is. A testnet order is watched
# only on the testnet chain, and a mainnet order is never watched there.
CRYPTO_PROCESSOR_BASE_SEPOLIA_RPC_URL=
CRYPTO_PROCESSOR_TESTNET_ENABLED=false
# The watcher reads the chain and grants cruush+ from what it finds. It starts
# only when this is true AND the processor is enabled AND an endpoint above is
# set. Leave it false until the settlement gates in
# docs/plans/v2-crypto-processor.md have passed.
CRYPTO_PROCESSOR_WATCHER_ENABLED=false
CRYPTO_PROCESSOR_WATCHER_INTERVAL_SECONDS=60

# Automatic forwarding service only (not read by the website/API): absolute path
# to the owner's mode-0600 private forwarding file, mounted read-only by Compose.
# Keep private file contents out of Git and frontend environment variables.
# CRUUSH_FORWARDING_KEY_FILE=/absolute/private/path/forwarding.json

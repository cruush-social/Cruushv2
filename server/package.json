{
  "name": "@cruush/server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "migrate:dev": "tsx src/migrate.ts",
    "seed:dev-profiles": "tsx src/dev-seed-profiles.ts",
    "seed:reviewer-accounts": "sh -c 'if [ -f dist/reviewer-test-accounts.js ]; then node --enable-source-maps dist/reviewer-test-accounts.js; else tsx src/reviewer-test-accounts.ts; fi'",
    "start": "node --enable-source-maps dist/index.js",
    "migrate": "node --enable-source-maps dist/migrate.js",
    "relationships:backfill": "tsx src/backfill-encrypted-relationships.ts",
    "location-privacy:backfill": "tsx src/backfill-encrypted-location-privacy.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@stream-io/node-sdk": "^0.7.59",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "@types/pg": "^8.15.6",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
